# === Llaves (obligatorias) ===
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Administradores (separados por coma): reciben aviso cuando alguien nuevo
# usa el bot y pueden bloquearlo. Todos los demás se registran solos con /start.
TELEGRAM_ALLOWED_IDS=

# Opcional: si lo llenas, la primera vez se pide este código para registrarse
CODIGO_ACCESO=

# === Supabase (la misma base del sistema FEVER) ===
SUPABASE_URL=
SUPABASE_ANON_KEY=

# === Opcionales ===
ZONA_HORARIA=America/Mexico_City
NOMBRE_AGENTE=Agente FEVER
MODELO_CLAUDE=claude-haiku-5-5
# low | medium | high  (medium: rápido y preciso para operación)
ESFUERZO_CLAUDE=medium
# Responder también con nota de voz cuando te hablan por voz (si / no). OpenAI se usa solo para transcribir.
RESPONDER_CON_VOZ=no
VOZ_RESPUESTA=coral
OPENAI_MODELO_TRANSCRIPCION=gpt-4o-mini-transcribe
OPENAI_MODELO_VOZ=gpt-4o-mini-tts
