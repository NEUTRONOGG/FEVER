{
  "name": "agente-fever",
  "version": "1.0.0",
  "private": true,
  "description": "Agente de operación FEVER por Telegram (voz y texto) conectado a Supabase",
  "type": "module",
  "scripts": {
    "desplegar": "wrangler deploy",
    "logs": "wrangler tail --format pretty",
    "local": "tsx src/index.ts",
    "verificar": "tsc --noEmit -p tsconfig.json && wrangler types && tsc --noEmit -p tsconfig.worker.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^18.0.10",
    "openai": "^7.55.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.1"
  }
}
